# Prefer pnpm configure to generate .env, or copy this example and fill values manually.
# Never paste actual credentials into tracked files.
NODE_ENV=development
JARVIS_HOST=127.0.0.1
JARVIS_PORT=4310
JARVIS_RP_ID=localhost
JARVIS_AUTH_ORIGIN=http://localhost:4310
DATABASE_URL=
POSTGRES_PASSWORD=
JARVIS_API_TOKEN=
LOG_LEVEL=info
# Voice provider configuration; native runtime receives short-lived credentials only.
# Store actual values only in private local/backend configuration.
# OPENAI_API_KEY=
JARVIS_REALTIME_MODEL=gpt-realtime-2.1
# Future phone and remote providers (not implemented):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Future optional E.164 owner number; validate before use:
# JARVIS_OWNER_PHONE=
