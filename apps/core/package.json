{
  "name": "@jarvis/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node --env-file=../../.env dist/main.js",
    "db:migrate": "tsx --env-file=../../.env src/migrate.ts",
    "build": "tsc --noEmit && node ../../infra/scripts/build-core.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jarvis/config": "workspace:*",
    "@jarvis/protocol": "workspace:*",
    "@jarvis/database": "workspace:*",
    "fastify": "^5.12.5",
    "@fastify/cors": "^11.0.0",
    "zod": "^4.0.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {}
}
