{
  "name": "@jarvis/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node --env-file=../../.env dist/main.js",
    "db:migrate": "tsx --env-file=../../.env src/migrate.ts",
    "build": "tsc --noEmit && node ../../infra/scripts/build-core.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/websocket": "11.3.1",
    "@jarvis/config": "workspace:*",
    "@jarvis/database": "workspace:*",
    "@jarvis/protocol": "workspace:*",
    "@jarvis/security": "workspace:*",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.2",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.5",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3"
  }
}
