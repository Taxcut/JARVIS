{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local window access to narrow native identity operations; no raw key, arbitrary signing, shell or filesystem commands.",
  "windows": ["main"],
  "permissions": [
    "allow-native-status",
    "allow-native-resume",
    "allow-native-api",
    "allow-native-begin",
    "allow-native-poll",
    "allow-runtime-status",
    "allow-runtime-start",
    "allow-runtime-connect",
    "allow-runtime-reconnect",
    "allow-runtime-stop",
    "allow-runtime-startup"
  ]
}
