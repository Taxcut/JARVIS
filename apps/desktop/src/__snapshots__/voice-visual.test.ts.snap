exports[`preserves the DEGRADED product surface 1`] = `"<section class="voice-experience" aria-labelledby="presence-title"><div class="presence-topline"><span><i class="signal online"></i>TRUSTED CONNECTION</span><span>PERSONAL INTELLIGENCE / 04</span></div><div class="presence-stage"><div class="intelligence-body " role="img" aria-label="JARVIS presence: alert"><div class="body-crosshair horizontal"></div><div class="body-crosshair vertical"></div></div><div class="body-caption"><span class="state-label">ALERT</span><h2 id="presence-title">Say “Jarvis.”</h2><p role="status">Isolated visual fixture</p></div><div class="orbit-note left"><span>LOCAL FIRST</span><b>YOUR SPACE.<br/>YOUR CONTROL.</b></div><div class="orbit-note right"><span>AUDIO CHANNEL</span><b>LOCAL WAKE ONLY</b></div></div><div class="voice-actions"><button class="secondary">Turn voice off<span aria-hidden="true">○</span></button><button class="secondary" aria-pressed="false">Mute microphone</button><label class="quality-label">Visual quality<select><option value="CINEMATIC">cinematic</option><option value="HIGH" selected="">high</option><option value="BALANCED">balanced</option><option value="LOW_POWER">low power</option></select></label></div><p class="privacy-note">Wake detection stays on this device. No audio is being sent online.</p><div class="conversation-strip"><div class="section-heading"><h3>Conversation</h3><span>PRIVATE · MEMORY ONLY</span></div><div class="conversation-empty"><span aria-hidden="true">〰</span><p>Your next conversation begins here.<small>Say “Jarvis” or “Hey Jarvis” after enabling voice.</small></p></div></div></section>"`;

