{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @jarvis/core --filter @jarvis/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:integration": "node infra/scripts/integration.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose --env-file .env -f infra/docker/compose.yml up -d --wait",
    "db:down": "docker compose --env-file .env -f infra/docker/compose.yml down",
    "db:migrate": "pnpm --filter @jarvis/core db:migrate",
    "desktop": "pnpm runtime:prepare && pnpm --filter @jarvis/desktop tauri dev",
    "rust:check": "pnpm runtime:prepare && cargo fmt --all --check && cargo check --workspace && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "configure": "tsx infra/scripts/configure.ts",
    "runtime:prepare": "node infra/scripts/prepare-runtime.mjs",
    "desktop:bundle": "pnpm runtime:prepare --release && pnpm --filter @jarvis/desktop tauri build",
    "desktop:verify-macos": "node infra/scripts/verify-macos-bundle.mjs",
    "voice:models": "cargo run --release -p jarvis-voice --example install_models",
    "voice:probe": "cargo run --release -p jarvis-voice --example model_probe",
    "visual:compare": "node infra/scripts/compare-visual.mjs",
    "voice:stt-models": "cargo run --release -p jarvis-voice --example install_models -- --stt",
    "voice:local-probe": "cargo run --release -p jarvis-voice --example local_probe",
    "voice:local-setup": "node infra/scripts/local-voice-setup.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "jpeg-js": "0.4.4",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.1"
  },
  "type": "module"
}
